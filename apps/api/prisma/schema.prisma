// ===========================================================================
// Men-3D — esquema de datos (multi-tenant, una sola base)
//
// Base: PostgreSQL. `docker compose up -d` levanta una local.
//
// El esquema sigue evitando enums nativos y arrays, y guarda las listas cortas
// como texto separado por comas. No es herencia de SQLite: es lo que mantiene
// las migraciones baratas (agregar un valor a un enum nativo bloquea la tabla)
// y el vocabulario en un solo lugar, `@men3d/shared`, validado con zod en el
// borde. Ver docs/DATABASE.md.
//
// Aislamiento entre restaurantes: cada tabla de negocio lleva `tenantId` y
// todas las consultas pasan por `src/lib/tenant-scope.ts`, que lo inyecta.
// ===========================================================================

generator client {
  provider = "prisma-client-js"
  // `native` para desarrollo; el target musl es el de la imagen Alpine con la
  // que se despliega. Sin declararlo, el motor de consultas no arranca dentro
  // del contenedor y el fallo recien aparece en el despliegue.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------------- PLATAFORMA

/// Catalogo de planes del SaaS: suscripcion mensual + setup inicial.
model Plan {
  id             String  @id @default(cuid())
  /// FREE | STARTER | PRO | ENTERPRISE
  tier           String  @unique
  name           String
  monthlyCents   Int
  /// Cobro unico de configuracion inicial (carga de carta + modelado 3D).
  setupFeeCents  Int     @default(0)
  /// Limites del plan; 0 = ilimitado.
  maxDishes      Int     @default(0)
  max3dModels    Int     @default(0)
  /// Lista de Feature separada por comas (ver PLAN_FEATURES en @men3d/shared).
  features       String  @default("")
  isPublic       Boolean @default(true)

  subscriptions Subscription[]
}

/// Un restaurante. Es la raiz de aislamiento de datos (el "tenant").
model Tenant {
  id          String   @id @default(cuid())
  /// Identificador de la URL publica: /m/:slug
  slug        String   @unique
  name        String
  description String?

  // --- contacto -----------------------------------------------------------
  phone    String?
  whatsapp String?
  email    String?

  // --- geolocalizacion (Google Maps) --------------------------------------
  addressLine   String?
  city          String?
  country       String?
  latitude      Float?
  longitude     Float?
  googlePlaceId String?

  // --- redes sociales -----------------------------------------------------
  instagramUrl String?
  tiktokUrl    String?
  facebookUrl  String?

  // --- operacion ----------------------------------------------------------
  openingHours String?
  currency     String @default("ARS")
  /// Idioma en el que el dueño carga la carta (idioma de origen).
  defaultLocale String @default("es")
  /// Idiomas ofrecidos al comensal, separados por comas: "es,en,pt".
  enabledLocales String @default("es")
  /// IVA en basis points (2100 = 21 %).
  taxRateBps   Int    @default(0)
  /// DINE_IN,TAKEAWAY,DELIVERY separados por comas.
  serviceModes String @default("DINE_IN")
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branding     Branding?
  subscription Subscription?
  users        User[]
  categories   Category[]
  dishes       Dish[]
  pairings     Pairing[]
  reviews      Review[]
  orders       Order[]
  events       AnalyticsEvent[]
  loyaltyAccounts LoyaltyAccount[]
  qrCodes      QrCode[]

  @@index([isActive])
}

/// Personalizacion visual del menu (1-1 con Tenant).
model Branding {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  logoUrl            String?
  faviconUrl         String?
  heroImageUrl       String?
  backgroundImageUrl String?
  primaryColor       String  @default("#2a78d6")
  accentColor        String  @default("#eb6834")
  surfaceColor       String  @default("#fcfcfb")
  textColor          String  @default("#0b0b0b")
  fontFamily         String  @default("Inter, system-ui, sans-serif")
  /// light | dark | system
  colorScheme        String  @default("system")

  updatedAt DateTime @updatedAt
}

model Subscription {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId   String
  plan     Plan   @relation(fields: [planId], references: [id])

  /// TRIALING | ACTIVE | PAST_DUE | CANCELED
  status        String    @default("TRIALING")
  trialEndsAt   DateTime?
  currentPeriodEnd DateTime?
  /// Si el setup inicial ya fue cobrado.
  setupFeePaid  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// Usuario del backoffice. El email es unico a nivel plataforma.
model User {
  id           String @id @default(cuid())
  tenantId     String
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String @unique
  name         String
  passwordHash String
  /// OWNER | ADMIN | STAFF | SUPPORT
  role         String @default("ADMIN")
  isActive     Boolean @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())

  @@index([tenantId])
}

// ------------------------------------------------------------------- CARTA

model Category {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// Orden de aparicion en el menu (menor primero).
  position    Int     @default(0)
  isActive    Boolean @default(true)

  dishes       Dish[]
  translations CategoryTranslation[]

  @@index([tenantId, position])
}

model CategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale     String
  name       String
  /// MANUAL | AUTO — AUTO lo escribio el traductor automatico.
  source     String   @default("AUTO")
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, locale])
}

model Dish {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  name        String
  description String?
  /// Precio en centavos de la moneda del tenant.
  priceCents  Int
  /// Precio anterior tachado (promociones).
  compareAtPriceCents Int?

  imageUrl String?
  /// Modelo 3D principal (GLB): lo consume <model-viewer> en web y en AR Android.
  modelGlbUrl  String?
  /// Variante USDZ para AR Quick Look de iOS.
  modelUsdzUrl String?
  /// Escala sugerida del modelo al colocarlo en RA.
  modelScale   Float?  @default(1)

  portionGrams Int?
  calories     Int?
  prepMinutes  Int?

  isAvailable Boolean @default(true)
  /// Destacado: el dueño lo sube arriba de la carta.
  isFeatured  Boolean @default(false)
  position    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Baja logica: conserva el historico de pedidos y analitica.
  archivedAt DateTime?

  allergens    DishAllergen[]
  dietTags     DishDietTag[]
  ingredients  DishIngredient[]
  translations DishTranslation[]
  reviews      Review[]
  orderItems   OrderItem[]
  events       AnalyticsEvent[]
  pairingsFrom Pairing[] @relation("PairingSource")
  pairingsTo   Pairing[] @relation("PairingTarget")

  @@index([tenantId, position])
  @@index([tenantId, categoryId])
  @@index([tenantId, archivedAt])
}

model DishTranslation {
  id          String  @id @default(cuid())
  dishId      String
  dish        Dish    @relation(fields: [dishId], references: [id], onDelete: Cascade)
  locale      String
  name        String
  description String?
  source      String  @default("AUTO")
  updatedAt   DateTime @updatedAt

  @@unique([dishId, locale])
  @@index([locale])
}

/// Alergeno declarado en un plato (filtro "no apto / contiene").
model DishAllergen {
  id       String @id @default(cuid())
  dishId   String
  dish     Dish   @relation(fields: [dishId], references: [id], onDelete: Cascade)
  /// Valor de Allergen (GLUTEN, MILK, ...).
  allergen String
  /// true = "puede contener trazas"; se muestra como advertencia suave.
  mayContain Boolean @default(false)

  @@unique([dishId, allergen])
  @@index([allergen])
}

/// Etiqueta de dieta apta (VEGAN, GLUTEN_FREE, ...).
model DishDietTag {
  id     String @id @default(cuid())
  dishId String
  dish   Dish   @relation(fields: [dishId], references: [id], onDelete: Cascade)
  tag    String

  @@unique([dishId, tag])
  @@index([tag])
}

model DishIngredient {
  id       String @id @default(cuid())
  dishId   String
  dish     Dish   @relation(fields: [dishId], references: [id], onDelete: Cascade)
  name     String
  position Int    @default(0)

  @@index([dishId])
}

/// Maridaje curado por el restaurante. Alimenta al recomendador junto con el
/// co-consumo historico calculado desde OrderItem.
model Pairing {
  id              String @id @default(cuid())
  tenantId        String
  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dishId          String
  dish            Dish   @relation("PairingSource", fields: [dishId], references: [id], onDelete: Cascade)
  suggestedDishId String
  suggestedDish   Dish   @relation("PairingTarget", fields: [suggestedDishId], references: [id], onDelete: Cascade)
  /// Valor de PairingReason.
  reason          String @default("CURATED")
  /// Peso manual 0..100 para ordenar sugerencias.
  weight          Int    @default(50)
  /// Copy mostrado al cliente; lo puede generar la IA.
  blurb           String?

  @@unique([dishId, suggestedDishId])
  @@index([tenantId])
}

// ----------------------------------------------------------------- RESEÑAS

/// `dishId` nulo = reseña general del local.
model Review {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dishId   String?
  dish     Dish?   @relation(fields: [dishId], references: [id], onDelete: Cascade)

  rating     Int
  comment    String?
  authorName String  @default("Anonimo")
  /// Identificador del comensal anonimo (localStorage), para evitar duplicados.
  guestId    String?
  /// PENDING | PUBLISHED | HIDDEN
  status     String  @default("PUBLISHED")
  /// Respuesta publica del restaurante.
  reply      String?
  createdAt  DateTime @default(now())

  @@index([tenantId, status, createdAt])
  @@index([dishId, status])
}

// ----------------------------------------------------------------- PEDIDOS

model Order {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Codigo corto que el comensal ve y canta en el mostrador: "A7F3".
  code     String

  /// Valor de OrderStatus.
  status      String @default("DRAFT")
  /// DINE_IN | TAKEAWAY | DELIVERY
  serviceMode String @default("DINE_IN")
  /// Mesa de la que se escaneo el QR.
  tableLabel  String?

  subtotalCents Int @default(0)
  taxCents      Int @default(0)
  discountCents Int @default(0)
  totalCents    Int @default(0)

  customerName  String?
  customerPhone String?
  customerEmail String?
  notes         String?
  guestId       String?

  pointsEarned   Int @default(0)
  pointsRedeemed Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Momento en que cocina lo acepto (para medir tiempos del KDS).
  acceptedAt DateTime?
  readyAt    DateTime?

  items   OrderItem[]
  payment Payment?
  ledger  LoyaltyLedger[]

  @@unique([tenantId, code])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, createdAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dishId  String
  dish    Dish   @relation(fields: [dishId], references: [id], onDelete: Restrict)

  /// Nombre y precio congelados al momento del pedido: si mañana cambia la
  /// carta, el historico y los informes siguen siendo fieles.
  nameSnapshot   String
  unitPriceCents Int
  quantity       Int    @default(1)
  notes          String?

  @@index([orderId])
  @@index([dishId])
}

model Payment {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// mock | stripe | mercadopago
  provider    String
  /// Id del cobro en la pasarela.
  providerRef String?
  /// Valor de PaymentStatus.
  status      String @default("REQUIRES_PAYMENT")
  amountCents Int
  currency    String @default("ARS")
  /// Respuesta cruda de la pasarela (JSON serializado) para auditoria.
  rawPayload  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([provider, providerRef])
}

// --------------------------------------------------------------- ANALITICA

/// Una fila por interaccion. Tabla de solo-escritura en caliente; los informes
/// agregan por rango de fechas. En Postgres conviene particionar por mes.
model AnalyticsEvent {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dishId   String?
  dish     Dish?  @relation(fields: [dishId], references: [id], onDelete: SetNull)

  /// Valor de AnalyticsEvent (MENU_OPEN, DISH_VIEW_3D, AR_LAUNCH, ...).
  type      String
  /// Agrupa los eventos de una misma visita sin cookies de terceros.
  sessionId String
  /// Tiempo con el modelo 3D en pantalla.
  durationMs Int?
  /// Termino buscado (solo en eventos SEARCH).
  query     String?
  locale    String?
  /// Campo numerico generico: cantidad de resultados, centavos del pedido, ...
  value     Int?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, type, createdAt])
  @@index([tenantId, dishId, type])
  @@index([sessionId])
}

// --------------------------------------------------------------- FIDELIDAD

model LoyaltyAccount {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Comensal anonimo identificado por el id guardado en su navegador.
  guestId  String
  email    String?
  balance  Int    @default(0)
  lifetimePoints Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledger LoyaltyLedger[]

  @@unique([tenantId, guestId])
}

/// Libro mayor de puntos: el saldo es la suma de sus movimientos.
model LoyaltyLedger {
  id        String @id @default(cuid())
  accountId String
  account   LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Positivo acumula, negativo canjea.
  points    Int
  /// Valor de LoyaltyReason.
  reason    String
  orderId   String?
  order     Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  /// Clave de idempotencia: evita acreditar dos veces el mismo hecho
  /// (p. ej. "ver el plato X en la sesion Y").
  dedupeKey String?
  createdAt DateTime @default(now())

  @@unique([accountId, dedupeKey])
  @@index([accountId, createdAt])
}

// ---------------------------------------------------------------------- QR

/// Un QR por mesa: el menu abre con la mesa ya identificada y el escaneo queda
/// contado, asi el dueño sabe que mesas usan el menu digital.
model QrCode {
  id         String @id @default(cuid())
  tenantId   String
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tableLabel String?
  /// Token corto que viaja en la URL: /m/:slug?t=<token>
  token      String @unique
  scans      Int    @default(0)
  lastScanAt DateTime?
  createdAt  DateTime @default(now())

  @@index([tenantId])
}
