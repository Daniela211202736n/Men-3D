{
  "name": "@men3d/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:push": "prisma db push --skip-generate && prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:plans": "tsx src/cli/sembrar-planes.ts",
    "db:plans:prod": "node dist/cli/sembrar-planes.js",
    "verificar": "tsx src/cli/verificar-credenciales.ts",
    "verificar:prod": "node dist/cli/verificar-credenciales.js",
    "db:studio": "prisma studio",
    "test": "AUTH_RATE_LIMIT_MAX=1000 node --test --import tsx test/*.test.ts",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1144.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@men3d/shared": "*",
    "@prisma/client": "6.12.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "draco3dgltf": "^1.5.7",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^6.0.0",
    "mercadopago": "^3.6.1",
    "pdfkit": "^0.17.2",
    "prisma": "6.12.0",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pdfkit": "^0.17.3",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
