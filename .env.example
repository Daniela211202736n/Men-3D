# ---------------------------------------------------------------------------
# Men-3D — variables de entorno (copiar a .env en la raiz del repo)
# ---------------------------------------------------------------------------

# --- Base de datos -------------------------------------------------------
# `docker compose up -d` levanta esta misma base en local.
DATABASE_URL="postgresql://men3d:men3d_dev@localhost:5432/men3d?schema=public"

# --- API -----------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Secreto para firmar los JWT del backoffice. CAMBIAR en produccion.
JWT_SECRET="cambiar-este-secreto-en-produccion-min-32-chars"
# Origenes permitidos por CORS, separados por coma
CORS_ORIGIN="http://localhost:5173"
# URL publica del menu, usada para generar los QR
PUBLIC_WEB_URL="http://localhost:5173"

# --- Pagos ---------------------------------------------------------------
# mock | stripe | mercadopago   (ver docs/PAYMENTS.md)
PAYMENTS_PROVIDER=mock

# URL publica de esta API. MercadoPago la usa para notificar los pagos, asi que
# tiene que ser alcanzable desde internet (en desarrollo: ngrok http 4000).
PUBLIC_API_URL="http://localhost:4000"

# Panel de MercadoPago -> Tus integraciones -> Credenciales.
# Un token TEST-... activa el checkout de prueba automaticamente.
MERCADOPAGO_ACCESS_TOKEN=""
# Panel -> Tus integraciones -> Webhooks. Sin esto no se puede verificar que una
# notificacion de pago venga realmente de MercadoPago (obligatorio en produccion).
MERCADOPAGO_WEBHOOK_SECRET=""

STRIPE_SECRET_KEY=""

# --- IA (opcional) -------------------------------------------------------
# Sin esta clave la traduccion automatica y el copy de maridajes quedan
# desactivados; las recomendaciones deterministas siguen funcionando.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"

# --- Almacenamiento de modelos 3D e imagenes -----------------------------
# local = disco del servidor, servido por la API (desarrollo).
# s3    = bucket + CDN (produccion). Ver docs/DEPLOY.md.
STORAGE_DRIVER=local

# Solo con STORAGE_DRIVER=s3. Funciona con AWS S3, Cloudflare R2,
# DigitalOcean Spaces o cualquier servicio compatible.
S3_BUCKET=""
S3_REGION="auto"
# Endpoint propio de R2/Spaces. Vacio = AWS S3.
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# true para servidores que no resuelven el bucket por subdominio (R2, MinIO).
S3_FORCE_PATH_STYLE=false
# Dominio del CDN desde el que se sirven los modelos al comensal.
CDN_PUBLIC_URL=""

# --- Frontend (Vite) -----------------------------------------------------
VITE_API_URL="http://localhost:4000"
VITE_GOOGLE_MAPS_KEY=""
